<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MASUD ADMIN</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        /* লগইন স্টাইল */
        .login-container {
            max-width: 400px;
            margin: 100px auto;
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            animation: slideDown 0.5s ease;
        }

        .login-container h2 {
            text-align: center;
            margin-bottom: 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .login-container input {
            width: 100%;
            padding: 15px;
            margin-bottom: 20px;
            border: 2px solid #eee;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s;
        }

        .login-container input:focus {
            border-color: #667eea;
            outline: none;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .login-container button {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .login-container button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .error-message {
            color: #f44336;
            text-align: center;
            margin-top: 10px;
            display: none;
        }

        /* অ্যাডমিন প্যানেল (আগের স্টাইল) */
        .admin-container {
            max-width: 1200px;
            margin: 0 auto;
            display: none; /* শুরুতে লুকানো থাকবে */
        }

        /* হেডার */
        .admin-header {
            background: white;
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            animation: slideDown 0.5s ease;
        }

        .admin-header h1 {
            font-size: 2.5em;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .admin-header p {
            color: #666;
            font-size: 1.1em;
        }

        /* ইনপুট ফর্ম */
        .input-form {
            background: white;
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 15px;
            border: 2px solid #eee;
            border-radius: 10px;
            font-size: 14px;
            font-family: 'Poppins', sans-serif;
            transition: all 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: #667eea;
            outline: none;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .form-group textarea {
            height: 150px;
            resize: vertical;
        }

        /* কোড এডিটর */
        .code-editor {
            font-family: 'Courier New', monospace !important;
            background: #1e1e1e !important;
            color: #d4d4d4 !important;
        }

        /* বাটন গ্রুপ */
        .button-group {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            flex: 1;
        }

        .btn-secondary {
            background: #2c3e50;
            color: white;
        }

        .btn-danger {
            background: #f44336;
            color: white;
        }

        .btn-logout {
            background: #f44336;
            color: white;
            margin-top: 20px;
            width: 100%;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        /* কার্ড গ্রিড */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .admin-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: all 0.3s;
            animation: cardFade 0.5s ease;
        }

        @keyframes cardFade {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        .admin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.2);
        }

        .card-image {
            width: 100%;
            height: 150px;
            overflow: hidden;
        }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .card-body {
            padding: 15px;
        }

        .card-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .card-btn {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s;
        }

        .card-btn.edit {
            background: #2196F3;
            color: white;
        }

        .card-btn.delete {
            background: #f44336;
            color: white;
        }

        .card-btn:hover {
            transform: scale(0.95);
        }

        /* নোটিফিকেশন */
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: #4caf50;
            color: white;
            padding: 15px 25px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            transform: translateX(400px);
            transition: transform 0.3s;
            z-index: 1000;
        }

        .notification.show {
            transform: translateX(0);
        }

        .notification.error {
            background: #f44336;
        }

        /* লোডার */
        .loader {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255,255,255,0.9);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .loader.active {
            display: flex;
        }

        .loader-spinner {
            width: 60px;
            height: 60px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* রেসপনসিভ */
        @media (max-width: 768px) {
            .admin-header h1 { font-size: 2em; }
            .button-group { flex-direction: column; }
            .btn { width: 100%; }
        }
    </style>
</head>
<body>
    <!-- লগইন ফর্ম -->
    <div class="login-container" id="loginForm">
        <h2><i class="fas fa-lock"></i> MASUD ADMIN লগইন</h2>
        <input type="password" id="passwordInput" placeholder="পাসওয়ার্ড দিন" onkeypress="if(event.key==='Enter') login()">
        <button onclick="login()"><i class="fas fa-sign-in-alt"></i> প্রবেশ করুন</button>
        <div class="error-message" id="loginError">ভুল পাসওয়ার্ড!</div>
    </div>

    <!-- অ্যাডমিন প্যানেল (লগইন成功后 দেখা যাবে) -->
    <div class="admin-container" id="adminPanel">
        <!-- হেডার -->
        <div class="admin-header">
            <h1>MASUD ADMIN</h1>
            <p>কন্টেন্ট ম্যানেজমেন্ট সিস্টেম</p>
            <button class="btn btn-logout" onclick="logout()"><i class="fas fa-sign-out-alt"></i> লগআউট</button>
        </div>

        <!-- ইনপুট ফর্ম -->
        <div class="input-form" id="inputForm">
            <h2 style="margin-bottom: 20px;">➕ নতুন আইটেম যোগ করুন</h2>
            
            <div class="form-group">
                <label><i class="fas fa-image"></i> ইমেজ লিংক (imgbb থেকে)</label>
                <input type="url" id="imageUrl" placeholder="https://i.ibb.co/..." required>
                <small style="color: #666;">imgbb থেকে সরাসরি ইমেজ লিংক দিন</small>
            </div>

            <div class="form-group">
                <label><i class="fas fa-code"></i> HTML কোড</label>
                <textarea id="htmlCode" class="code-editor" placeholder="আপনার HTML কোড লিখুন..."></textarea>
            </div>

            <div class="form-group">
                <label><i class="fas fa-paint-brush"></i> CSS কোড</label>
                <textarea id="cssCode" class="code-editor" placeholder="আপনার CSS কোড লিখুন..."></textarea>
            </div>

            <div class="form-group">
                <label><i class="fab fa-js"></i> JavaScript কোড</label>
                <textarea id="jsCode" class="code-editor" placeholder="আপনার JavaScript কোড লিখুন..."></textarea>
            </div>

            <div class="form-group">
                <label><i class="fas fa-tag"></i> AI অপশন (ঐচ্ছিক)</label>
                <select id="aiOption">
                    <option value="">ছাড়া AI অপশন</option>
                    <option value="chat">চ্যাটবট যোগ করুন</option>
                    <option value="analyze">কোড অ্যানালাইসিস</option>
                    <option value="optimize">কোড অপটিমাইজ</option>
                </select>
            </div>

            <div class="button-group">
                <button class="btn btn-primary" onclick="saveCard()">
                    <i class="fas fa-save"></i> কোড সেন্ড করুন
                </button>
                <button class="btn btn-secondary" onclick="resetForm()">
                    <i class="fas fa-undo"></i> রিসেট
                </button>
            </div>
        </div>

        <!-- কার্ড লিস্ট -->
        <div class="input-form">
            <h2 style="margin-bottom: 20px;">📦 আপলোড করা আইটেম</h2>
            <div class="cards-grid" id="cardsList"></div>
        </div>
    </div>

    <!-- নোটিফিকেশন -->
    <div class="notification" id="notification">
        <i class="fas fa-check-circle"></i>
        <span id="notificationMessage"></span>
    </div>

    <!-- লোডার -->
    <div class="loader" id="loader">
        <div class="loader-spinner"></div>
    </div>

    <script>
        // সঠিক পাসওয়ার্ড
        const CORRECT_PASSWORD = "masud511";

        // চেক করা যে আগে থেকে লগইন করা আছে কিনা (sessionStorage)
        (function checkLogin() {
            if (sessionStorage.getItem('masudAdminLoggedIn') === 'true') {
                showAdminPanel();
            } else {
                showLoginForm();
            }
        })();

        function login() {
            const password = document.getElementById('passwordInput').value;
            if (password === CORRECT_PASSWORD) {
                sessionStorage.setItem('masudAdminLoggedIn', 'true');
                showAdminPanel();
                document.getElementById('loginError').style.display = 'none';
            } else {
                document.getElementById('loginError').style.display = 'block';
            }
        }

        function logout() {
            sessionStorage.removeItem('masudAdminLoggedIn');
            showLoginForm();
        }

        function showAdminPanel() {
            document.getElementById('loginForm').style.display = 'none';
            document.getElementById('adminPanel').style.display = 'block';
            // পুনরায় কার্ড লোড
            loadCards();
        }

        function showLoginForm() {
            document.getElementById('loginForm').style.display = 'block';
            document.getElementById('adminPanel').style.display = 'none';
            document.getElementById('passwordInput').value = '';
        }

        // কার্ড ডাটা স্টোর
        let cards = [];

        function loadCards() {
            try {
                cards = JSON.parse(localStorage.getItem('masudCards')) || [];
            } catch (e) {
                cards = [];
            }
            renderCards();
        }

        // নোটিফিকেশন দেখান
        function showNotification(message, isError = false) {
            const notification = document.getElementById('notification');
            const messageSpan = document.getElementById('notificationMessage');
            
            messageSpan.textContent = message;
            notification.classList.add('show');
            if (isError) {
                notification.classList.add('error');
            } else {
                notification.classList.remove('error');
            }
            
            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }

        // লোডার কন্ট্রোল
        function showLoader() {
            document.getElementById('loader').classList.add('active');
        }

        function hideLoader() {
            document.getElementById('loader').classList.remove('active');
        }

        // কার্ড সেভ
        function saveCard() {
            const imageUrl = document.getElementById('imageUrl').value.trim();
            const htmlCode = document.getElementById('htmlCode').value.trim();
            const cssCode = document.getElementById('cssCode').value.trim();
            const jsCode = document.getElementById('jsCode').value.trim();
            const aiOption = document.getElementById('aiOption').value;

            if (!imageUrl) {
                showNotification('ইমেজ লিংক দিন!', true);
                return;
            }

            if (!htmlCode && !cssCode && !jsCode) {
                showNotification('কমপক্ষে একটি কোড দিন!', true);
                return;
            }

            showLoader();

            setTimeout(() => {
                const newCard = {
                    id: Date.now(),
                    image: imageUrl,
                    html: htmlCode,
                    css: cssCode,
                    js: jsCode,
                    ai: aiOption,
                    timestamp: new Date().toLocaleString()
                };

                cards.unshift(newCard);
                localStorage.setItem('masudCards', JSON.stringify(cards));

                renderCards();
                resetForm();
                hideLoader();
                showNotification('কোড সফলভাবে সেন্ড হয়েছে!');

                // ওয়েবসাইটে আপডেট পাঠান
                localStorage.setItem('masudUpdate', Date.now());
            }, 500);
        }

        // কার্ড রেন্ডার
        function renderCards() {
            const container = document.getElementById('cardsList');
            if (!container) return;

            if (cards.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #999;">কোনো আইটেম নেই</p>';
                return;
            }

            container.innerHTML = cards.map((card, index) => `
                <div class="admin-card">
                    <div class="card-image">
                        <img src="${card.image}" alt="প্রোজেক্ট ইমেজ" onerror="this.src='https://via.placeholder.com/300x150?text=Image+Error'">
                    </div>
                    <div class="card-body">
                        <small style="color: #666;">${card.timestamp || 'এখনই'}</small>
                        ${card.ai ? `<p><small>🤖 AI: ${card.ai}</small></p>` : ''}
                        <div class="card-actions">
                            <button class="card-btn edit" onclick="editCard(${index})">
                                <i class="fas fa-edit"></i> এডিট
                            </button>
                            <button class="card-btn delete" onclick="deleteCard(${index})">
                                <i class="fas fa-trash"></i> ডিলিট
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // কার্ড এডিট
        function editCard(index) {
            const card = cards[index];
            
            document.getElementById('imageUrl').value = card.image || '';
            document.getElementById('htmlCode').value = card.html || '';
            document.getElementById('cssCode').value = card.css || '';
            document.getElementById('jsCode').value = card.js || '';
            document.getElementById('aiOption').value = card.ai || '';

            deleteCard(index);
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // কার্ড ডিলিট
        function deleteCard(index) {
            if (confirm('আপনি কি এই আইটেমটি ডিলিট করতে চান?')) {
                cards.splice(index, 1);
                localStorage.setItem('masudCards', JSON.stringify(cards));
                renderCards();
                showNotification('আইটেম ডিলিট হয়েছে!');
                
                // ওয়েবসাইটে আপডেট পাঠান
                localStorage.setItem('masudUpdate', Date.now());
            }
        }

        // ফর্ম রিসেট
        function resetForm() {
            document.getElementById('imageUrl').value = '';
            document.getElementById('htmlCode').value = '';
            document.getElementById('cssCode').value = '';
            document.getElementById('jsCode').value = '';
            document.getElementById('aiOption').value = '';
        }

        // লোকাল স্টোরেজ চেঞ্জ শোনা
        window.addEventListener('storage', (e) => {
            if (e.key === 'masudCards') {
                cards = JSON.parse(e.newValue) || [];
                renderCards();
            }
        });
    </script>
</body>
</html>