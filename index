<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DEVOLOPER MASUD - পোর্টফোলিও</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        /* থিম কন্ট্রোলার */
        .theme-controller {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            gap: 10px;
        }

        .theme-btn {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 3px solid white;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: transform 0.3s;
        }

        .theme-btn:hover {
            transform: scale(1.1);
        }

        .theme-btn[data-theme="light"] { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); }
        .theme-btn[data-theme="dark"] { background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%); }
        .theme-btn[data-theme="purple"] { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .theme-btn[data-theme="green"] { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); }
        .theme-btn[data-theme="orange"] { background: linear-gradient(135deg, #f12711 0%, #f5af19 100%); }

        /* হেডার */
        .header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 20px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header h1 {
            font-size: 2.5em;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .header p {
            color: #666;
            font-size: 1.1em;
        }

        /* গ্রিড লেআউট */
        .container {
            max-width: 1400px;
            margin: 40px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px;
        }

        /* কার্ড স্টাইল */
        .card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            transform: translateY(0);
            transition: all 0.3s ease;
            animation: fadeIn 0.5s ease;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card-image {
            width: 100%;
            height: 200px;
            overflow: hidden;
            cursor: pointer;
            position: relative;
        }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .card-image:hover img {
            transform: scale(1.1);
        }

        .card-image::after {
            content: '🔍 ক্লিক করুন';
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .card-image:hover::after {
            opacity: 1;
        }

        .card-content {
            padding: 20px;
        }

        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .btn {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-preview {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-code {
            background: #2c3e50;
            color: white;
        }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        }

        /* মোডাল */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.9);
            z-index: 2000;
            padding: 40px;
            overflow-y: auto;
        }

        .modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 20px;
            max-width: 800px;
            width: 100%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
            animation: modalSlideIn 0.3s;
        }

        @keyframes modalSlideIn {
            from { transform: translateY(-50px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #f44336;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s;
        }

        .modal-close:hover {
            transform: scale(1.1);
        }

        .preview-iframe {
            width: 100%;
            height: 400px;
            border: 2px solid #eee;
            border-radius: 10px;
        }

        .code-block {
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 20px;
            border-radius: 10px;
            overflow-x: auto;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            line-height: 1.5;
            margin-top: 15px;
        }

        /* লোডার */
        .loader {
            display: none;
            text-align: center;
            padding: 50px;
        }

        .loader.active {
            display: block;
        }

        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* রেসপনসিভ */
        @media (max-width: 768px) {
            .header h1 { font-size: 2em; }
            .container { grid-template-columns: 1fr; }
            .theme-controller { top: 10px; right: 10px; }
            .theme-btn { width: 35px; height: 35px; }
        }
    </style>
</head>
<body>
    <!-- থিম কন্ট্রোলার -->
    <div class="theme-controller">
        <div class="theme-btn" data-theme="light" onclick="changeTheme('light')"></div>
        <div class="theme-btn" data-theme="dark" onclick="changeTheme('dark')"></div>
        <div class="theme-btn" data-theme="purple" onclick="changeTheme('purple')"></div>
        <div class="theme-btn" data-theme="green" onclick="changeTheme('green')"></div>
        <div class="theme-btn" data-theme="orange" onclick="changeTheme('orange')"></div>
    </div>

    <!-- হেডার -->
    <div class="header">
        <h1>DEVOLOPER MASUD</h1>
        <p>ক্রিয়েটিভ কোড ও ডিজাইন শোকেস</p>
    </div>

    <!-- লোডার -->
    <div class="loader" id="loader">
        <div class="loader-spinner"></div>
        <p>ডাটা লোড হচ্ছে...</p>
    </div>

    <!-- কার্ড কন্টেইনার -->
    <div class="container" id="cardContainer"></div>

    <!-- প্রিভিউ মোডাল -->
    <div class="modal" id="previewModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closePreview()"><i class="fas fa-times"></i></button>
            <h2 style="margin-bottom: 20px;">🔍 প্রিভিউ</h2>
            <iframe class="preview-iframe" id="previewFrame"></iframe>
        </div>
    </div>

    <!-- কোড মোডাল -->
    <div class="modal" id="codeModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeCode()"><i class="fas fa-times"></i></button>
            <h2 style="margin-bottom: 20px;">📝 সম্পূর্ণ কোড</h2>
            <pre class="code-block" id="codeDisplay"></pre>
        </div>
    </div>

    <script>
        // কার্ড ডাটা স্টোর
        let cards = JSON.parse(localStorage.getItem('masudCards')) || [];

        // থিম চেঞ্জ
        function changeTheme(theme) {
            const body = document.body;
            const gradients = {
                light: 'linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%)',
                dark: 'linear-gradient(135deg, #2c3e50 0%, #3498db 100%)',
                purple: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                green: 'linear-gradient(135deg, #11998e 0%, #38ef7d 100%)',
                orange: 'linear-gradient(135deg, #f12711 0%, #f5af19 100%)'
            };
            body.style.background = gradients[theme];
            localStorage.setItem('masudTheme', theme);
        }

        // সেভ করা থিম লোড
        const savedTheme = localStorage.getItem('masudTheme');
        if (savedTheme) changeTheme(savedTheme);

        // কার্ড রেন্ডার
        function renderCards() {
            const container = document.getElementById('cardContainer');
            container.innerHTML = '';
            
            cards.forEach((card, index) => {
                const cardHTML = `
                    <div class="card" style="animation-delay: ${index * 0.1}s">
                        <div class="card-image" onclick="showPreview(${index})">
                            <img src="${card.image}" alt="প্রোজেক্ট ইমেজ">
                        </div>
                        <div class="card-content">
                            <div class="button-group">
                                <button class="btn btn-preview" onclick="showPreview(${index})">
                                    <i class="fas fa-eye"></i> প্রিভিউ
                                </button>
                                <button class="btn btn-code" onclick="showCode(${index})">
                                    <i class="fas fa-code"></i> কোড
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += cardHTML;
            });
        }

        // প্রিভিউ দেখান
        function showPreview(index) {
            const card = cards[index];
            const previewModal = document.getElementById('previewModal');
            const previewFrame = document.getElementById('previewFrame');
            
            let html = card.html || '';
            let css = card.css || '';
            let js = card.js || '';
            
            const fullHTML = `
                <!DOCTYPE html>
                <html>
                <head>
                    <style>${css}</style>
                </head>
                <body>
                    ${html}
                    <script>${js}<\/script>
                </body>
                </html>
            `;
            
            previewFrame.srcdoc = fullHTML;
            previewModal.classList.add('active');
        }

        // কোড দেখান
        function showCode(index) {
            const card = cards[index];
            const codeModal = document.getElementById('codeModal');
            const codeDisplay = document.getElementById('codeDisplay');
            
            const fullCode = `<!-- HTML কোড -->\n${card.html || ''}\n\n/* CSS কোড */\n${card.css || ''}\n\n// JavaScript কোড\n${card.js || ''}`;
            
            codeDisplay.textContent = fullCode;
            codeModal.classList.add('active');
        }

        // মোডাল বন্ধ
        function closePreview() {
            document.getElementById('previewModal').classList.remove('active');
            document.getElementById('previewFrame').srcdoc = '';
        }

        function closeCode() {
            document.getElementById('codeModal').classList.remove('active');
        }

        // লোডার কন্ট্রোল
        function showLoader() {
            document.getElementById('loader').classList.add('active');
        }

        function hideLoader() {
            document.getElementById('loader').classList.remove('active');
        }

        // লোকাল স্টোরেজ চেক
        function checkStorage() {
            showLoader();
            setTimeout(() => {
                renderCards();
                hideLoader();
            }, 1000);
        }

        // প্রতি 5 সেকেন্ডে আপডেট চেক
        setInterval(() => {
            const newCards = JSON.parse(localStorage.getItem('masudCards')) || [];
            if (JSON.stringify(newCards) !== JSON.stringify(cards)) {
                cards = newCards;
                renderCards();
            }
        }, 5000);

        // ইনিশিয়াল লোড
        window.addEventListener('load', checkStorage);

        // ক্লিকের বাইরে মোডাল বন্ধ
        window.addEventListener('click', (e) => {
            const previewModal = document.getElementById('previewModal');
            const codeModal = document.getElementById('codeModal');
            
            if (e.target === previewModal) closePreview();
            if (e.target === codeModal) closeCode();
        });
    </script>
</body>
</html>